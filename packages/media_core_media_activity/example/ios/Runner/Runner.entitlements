<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Same App Group as the Widget Extension; see that file's comment.
	     In Xcode this is normally generated by Signing & Capabilities >
	     App Groups; this reference file exists so the id cannot drift. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.media_core.media_activity</string>
	</array>
</dict>
</plist>
