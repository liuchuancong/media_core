<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mediacore.nativeprobe">
    <!--
      The probe only reads: codec lists, memory, features, displays. It declares
      no permission for that, because asking for one to describe a device would be
      asking the user for something the answer does not need.
    -->

    <!--
      Background execution (a recording or a download that must survive the app
      going to the background). Each feature runs as its own foreground service,
      with its own notification and its own wake lock, so nothing that happens to
      one of them — a release, a permission the user declined, the six-hour
      dataSync allowance — can end another's protection.

      A plain <service> merges from a library manifest, so the app inherits all
      three without copying anything.

      POST_NOTIFICATIONS is declared but never asked for here: from API 33 a
      foreground service shows its notification only with it, and when the user is
      asked is the app's decision (MediaCoreNotify.requestPermission is the one
      entry point). Without the permission the service still runs and the lock still
      holds — only the line in the shade is missing.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Fully qualified on purpose: a relative name in a library manifest
             resolves against the app's package, not this one. -->

        <!-- A live capture has no useful bound, and dataSync is capped at six
             hours a day on Android 15, so recording declares specialUse. Play Store
             policy wants a justification for specialUse; the subsystem role below is
             where that sentence lives, and a host shipping its own recording feature
             should expect to repeat it in the store listing. -->
        <service
            android:name="com.mediacore.nativeprobe.RecordingForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Long-running capture of a media stream to storage, started by the user and continuing while the app is backgrounded." />
        </service>

        <service
            android:name="com.mediacore.nativeprobe.DownloadForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name="com.mediacore.nativeprobe.GenericForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
